# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_USERNAME=G-YOUNG01

# 认证
# 仅用于 `npm run seed` 首次初始化管理员；登录认证从数据库 users 表读取。
# 生产环境请改成非常规用户名（默认 gyoung 已被公开分析报告披露），或 seed 后在工作台「账号设置」修改。
ADMIN_USERNAME=gyoung
# 注意：bcrypt 哈希中的 $ 需转义为 \$（如 \$2b\$10\$...），否则会被 dotenv 展开吞掉
ADMIN_PASSWORD_HASH=\$2b\$10\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSION_SECRET=xxxxxxxxxxxx

# 站点
SITE_URL=https://gyoung.xyz

# 数据库
DATABASE_URL=file:./data.db

# 运行环境
NODE_ENV=production
