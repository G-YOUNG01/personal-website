# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_USERNAME=G-YOUNG01

# 认证
ADMIN_USERNAME=gyoung
# 注意：bcrypt 哈希中的 $ 需转义为 \$（如 \$2b\$10\$...），否则会被 dotenv 展开吞掉
ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxx
SESSION_SECRET=xxxxxxxxxxxx

# 站点
SITE_URL=https://gyoung.xyz

# 数据库
DATABASE_URL=file:./data.db

# 评论区（Giscus，基于 GitHub Discussions）
# 在 https://giscus.app/zh-CN 配置后填入 repo-id / category-id
GISCUS_REPO=G-YOUNG01/personal-website
GISCUS_REPO_ID=
GISCUS_CATEGORY=General
GISCUS_CATEGORY_ID=

# 运行环境
NODE_ENV=production
